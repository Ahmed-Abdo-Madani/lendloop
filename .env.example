# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-Touch.clerk.accounts.dev

# Convex Backend
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# n8n Bidirectional Webhook Security (stored in Convex env & n8n env — never in code)
LENDLOOP_WEBHOOK_SECRET=replace_with_32_byte_hex_hmac_secret
N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-borrow-event
N8N_ENCRYPTION_KEY=replace_with_32_byte_n8n_encryption_key
