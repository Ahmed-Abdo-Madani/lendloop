{
  "name": "LendLoop — 2. Daily Overdue Loan Reminders (Scheduled + Idempotent)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "c2f3d4e5-0002-4000-8000-000000000001",
      "name": "Daily 09:00 UTC Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nif (!secret) throw new Error('Missing LENDLOOP_WEBHOOK_SECRET');\nconst asOfDate = new Date().toISOString().slice(0, 10);\nconst rawBody = JSON.stringify({ asOfDate });\nconst ts = Math.floor(Date.now() / 1000);\nconst mac = crypto.createHmac('sha256', secret).update(`${ts}.${rawBody}`, 'utf8').digest('hex');\nreturn [{ json: { asOfDate, rawBody, signatureHeader: `t=${ts},v1=${mac}` } }];"
      },
      "id": "c2f3d4e5-0002-4000-8000-000000000002",
      "name": "Sign Overdue Fetch Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_HTTP_URL + '/api/overdue-loans' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signatureHeader }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.rawBody }}",
        "options": {}
      },
      "id": "c2f3d4e5-0002-4000-8000-000000000003",
      "name": "Fetch Overdue Loans from Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.LENDLOOP_WEBHOOK_SECRET;\nconst data = $input.first().json;\nconst today = data.today;\nconst loans = data.overdueLoans || [];\n\nreturn loans.map(loan => {\n  console.log(`[LendLoop Overdue Reminder] Sent to ${loan.borrowerEmail} for \"${loan.toolName}\" (due ${loan.endDate})`);\n  const callbackPayload = JSON.stringify({\n    idempotencyKey: loan.idempotencyKey,\n    requestId: loan.requestId,\n    workflowType: 'overdue_reminder',\n    summary: `Overdue reminder sent on ${today}`,\n    status: 'delivered',\n    reminderDate: today\n  });\n  const ts = Math.floor(Date.now() / 1000);\n  const mac = crypto.createHmac('sha256', secret).update(`${ts}.${callbackPayload}`, 'utf8').digest('hex');\n  return {\n    json: {\n      callbackPayload,\n      signatureHeader: `t=${ts},v1=${mac}`\n    }\n  };\n});"
      },
      "id": "c2f3d4e5-0002-4000-8000-000000000004",
      "name": "Send Reminders & Prepare Idempotent Callbacks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_HTTP_URL + '/api/automation-callback' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signatureHeader }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.callbackPayload }}",
        "options": {}
      },
      "id": "c2f3d4e5-0002-4000-8000-000000000005",
      "name": "Write Reminder Status Back to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Daily 09:00 UTC Schedule": {
      "main": [
        [
          {
            "node": "Sign Overdue Fetch Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Overdue Fetch Request": {
      "main": [
        [
          {
            "node": "Fetch Overdue Loans from Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overdue Loans from Convex": {
      "main": [
        [
          {
            "node": "Send Reminders & Prepare Idempotent Callbacks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Reminders & Prepare Idempotent Callbacks": {
      "main": [
        [
          {
            "node": "Write Reminder Status Back to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lendloop-error-handler"
  }
}
